{
  "name": "discord-prop-bet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --env local",
    "dev:discord": "npm run build && wrangler dev --env \"\"",
    "build": "vite build",
    "test": "node --test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env \"\"",
    "deploy": "npm run build && wrangler deploy --env \"\"",
    "deploy:check": "npm run build && wrangler deploy --dry-run --env \"\""
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.4.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "wrangler": "^4.45.0"
  }
}
